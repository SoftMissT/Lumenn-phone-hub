<div class="lph-content-app lph-ig" data-lph-content="{{appId}}">
    <header class="lph-ig-header">
        <span class="lph-ig-wordmark">Instagram</span>
        <span class="lph-ig-header-actions" aria-hidden="true">
            <i class="far fa-heart"></i>
            <i class="far fa-paper-plane"></i>
        </span>
    </header>
    {{#if canPost}}
    <div class="lph-ig-compose">
        <input type="text" class="lph-ig-caption" data-lph-post-caption maxlength="500"
               autocomplete="off" placeholder="{{captionPlaceholder}}" aria-label="{{captionPlaceholder}}">
        <button type="button" class="lph-add-photo" data-lph-new-post aria-label="{{postLabel}}">
            <i class="fas fa-plus" aria-hidden="true"></i>
        </button>
    </div>
    {{else if postLocked}}
    <div class="lph-ig-compose">
        <button type="button" class="lph-add-photo lph-add-photo-locked" disabled title="{{postHint}}" aria-label="{{postHint}}">
            <i class="fas fa-lock" aria-hidden="true"></i>
        </button>
    </div>
    {{/if}}
    {{#if stories}}
        <div class="lph-ig-stories">
            {{#each stories}}
            <button class="lph-ig-story" type="button" data-lph-story
                    data-image="{{this.image}}" data-sender="{{this.sender}}"
                    aria-label="{{this.sender}}">
                <span class="lph-ig-story-ring">
                    <img src="{{this.image}}" alt="" loading="lazy">
                </span>
                <span class="lph-ig-story-name">{{this.sender}}</span>
            </button>
            {{/each}}
        </div>
    {{else}}
        <div class="lph-ig-stories lph-ig-stories-empty">
            <button class="lph-ig-story" type="button" disabled>
                <span class="lph-ig-story-ring lph-ig-story-placeholder"><i class="fas fa-plus"></i></span>
                <span class="lph-ig-story-name">{{storyOwnLabel}}</span>
            </button>
        </div>
    {{/if}}

    {{#if total}}
        {{#each items}}
        <article class="lph-ig-post" data-lph-ig-post data-sender="{{this.sender}}">
            <header class="lph-ig-post-head">
                <span class="lph-ig-avatar">{{#if this.image}}<img src="{{this.image}}" alt="" loading="lazy">{{else}}<i class="fas fa-user" aria-hidden="true"></i>{{/if}}</span>
                <span class="lph-ig-user">{{#if this.sender}}{{this.sender}}{{else}}lumenn{{/if}}</span>
            </header>
            {{#if this.image}}<img class="lph-ig-media" src="{{this.image}}" alt="" loading="lazy">{{/if}}
            <div class="lph-ig-actions">
                <button type="button" class="lph-ig-like{{#if this.liked}} is-liked{{/if}}" data-lph-like="{{this.id}}" aria-pressed="{{#if this.liked}}true{{else}}false{{/if}}" aria-label="{{../likeLabel}}">
                    <i class="{{#if this.liked}}fas{{else}}far{{/if}} fa-heart" aria-hidden="true"></i>
                </button>
                <i class="far fa-comment" aria-hidden="true"></i>
                <i class="far fa-paper-plane" aria-hidden="true"></i>
                <i class="far fa-bookmark" aria-hidden="true"></i>
            </div>
            {{#if this.title}}<p class="lph-ig-caption"><strong>{{this.sender}}</strong> {{this.title}}</p>{{/if}}
            {{#if this.body}}<p class="lph-ig-body">{{this.body}}</p>{{/if}}
        </article>
        {{/each}}
        <p class="lph-ig-tab-empty" data-lph-ig-tab-empty hidden>{{instagramEmptyHint}}</p>
    {{else}}
        <div class="lph-ig-empty">
            <span class="lph-ig-empty-icon"><i class="fa-brands fa-instagram"></i></span>
            <strong>{{emptyText}}</strong>
            <span>{{instagramEmptyHint}}</span>
        </div>
    {{/if}}
    <div class="lph-ig-story-viewer" data-lph-story-viewer role="dialog" aria-modal="true" tabindex="-1" hidden>
        <div class="lph-ig-story-progress" aria-hidden="true"><span></span></div>
        <header class="lph-ig-story-viewer-head">
            <strong data-lph-story-sender></strong>
            <button type="button" data-lph-story-close aria-label="{{localize 'LPH.Phone.Close'}}">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <img data-lph-story-image alt="">
    </div>
    <nav class="lph-ig-tabs" aria-label="Instagram">
        <button type="button" class="is-active" data-lph-ig-tab="home" aria-label="{{localize 'LPH.Apps.InstagramHome'}}" aria-current="page"><i class="fas fa-house"></i></button>
        <button type="button" aria-label="{{localize 'LPH.Apps.InstagramVideos'}}" disabled><i class="fas fa-film"></i></button>
        <button type="button" data-lph-ig-tab="messages" aria-label="{{localize 'LPH.Apps.Messages'}}"><i class="fas fa-comment"></i></button>
        <button type="button" data-lph-ig-tab="explore" aria-label="{{localize 'LPH.Apps.InstagramExplore'}}"><i class="fas fa-magnifying-glass"></i></button>
        <button type="button" data-lph-ig-tab="profile" aria-label="{{localize 'LPH.Apps.InstagramProfile'}}"><i class="fas fa-user"></i></button>
    </nav>
</div>
