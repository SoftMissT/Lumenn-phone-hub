<div class="lph-content-app" data-lph-content="{{appId}}">
    {{#if canAddPhoto}}
    <div class="lph-media-bar">
        <button type="button" class="lph-add-photo" data-lph-add-photo aria-label="{{addPhotoLabel}}">
            <i class="fas fa-plus" aria-hidden="true"></i>
        </button>
    </div>
    {{else if photosNeedsPermission}}
    <div class="lph-media-bar">
        <button type="button" class="lph-add-photo lph-add-photo-locked" disabled title="{{addPhotoHint}}" aria-label="{{addPhotoHint}}">
            <i class="fas fa-lock" aria-hidden="true"></i>
        </button>
    </div>
    {{/if}}
    {{#if canCompose}}
    <form class="lph-compose" data-lph-compose>
        <select name="to" required aria-label="{{composeToLabel}}">
            <option value="">{{composeToLabel}}</option>
            {{#each recipients}}
            <option value="{{this.uuid}}">{{this.name}}</option>
            {{/each}}
        </select>
        <input type="text" name="body" maxlength="500" autocomplete="off"
               placeholder="{{composePlaceholder}}" aria-label="{{composePlaceholder}}">
        <button type="submit" aria-label="{{sendLabel}}">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>
        </button>
    </form>
    {{/if}}
    {{#if total}}
        {{#if threaded}}
            {{#each threads}}
            <article class="lph-thread" data-lph-thread="{{this.id}}">
                <header class="lph-thread-head">
                    <button type="button" class="lph-thread-back" data-lph-thread-back aria-label="{{../backLabel}}">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="lph-thread-open" data-lph-thread-open aria-label="{{this.last.sender}}">
                    {{#if this.last.avatar}}
                    <img class="lph-avatar lph-avatar-img" src="{{this.last.avatar}}" alt="" loading="lazy">
                    {{else}}
                    <span class="lph-avatar" style="--lph-avatar-hue: {{this.avatarHue}}">{{this.initial}}</span>
                    {{/if}}
                    <span class="lph-thread-meta">
                        <span class="lph-thread-name">{{this.last.sender}}</span>
                        <span class="lph-thread-preview">{{this.preview}}</span>
                    </span>
                    {{#if this.unread}}<span class="lph-thread-count">{{this.unread}}</span>{{/if}}
                    </button>
                </header>
                <div class="lph-thread-body">
                    {{#each this.lines}}
                    {{#if this.isDate}}
                    <div class="lph-chat-date"><span>{{this.label}}</span></div>
                    {{else}}
                    <div class="lph-chat-row{{#if this.mine}} is-mine{{/if}}">
                        {{#unless this.mine}}
                        {{#if this.opensGroup}}
                        {{#if this.avatar}}
                        <img class="lph-chat-avatar lph-avatar-img" src="{{this.avatar}}" alt="" loading="lazy">
                        {{else}}
                        <span class="lph-chat-avatar lph-avatar" style="--lph-avatar-hue: {{this.hue}}">{{this.initial}}</span>
                        {{/if}}
                        {{else}}
                        <span class="lph-chat-avatar-spacer" aria-hidden="true"></span>
                        {{/if}}
                        {{/unless}}
                        <div class="lph-chat-stack">
                            {{#unless this.mine}}
                            {{#if this.opensGroup}}<span class="lph-chat-name">{{this.sender}}</span>{{/if}}
                            {{/unless}}
                            <div class="lph-chat-line">
                                <div class="lph-bubble{{#if this.mine}} lph-bubble-mine{{/if}}">
                                    {{#if this.title}}<p class="lph-bubble-title">{{this.title}}</p>{{/if}}
                                    {{#if this.body}}<p class="lph-bubble-body">{{this.body}}</p>{{/if}}
                                </div>
                                {{#if this.time}}<span class="lph-chat-time">{{this.time}}</span>{{/if}}
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    {{/each}}
                    {{#if ../canReply}}
                    <form class="lph-reply" data-lph-reply data-lph-thread-id="{{this.id}}">
                        <input type="text" name="body" maxlength="500" autocomplete="off"
                               placeholder="{{../replyPlaceholder}}" aria-label="{{../replyPlaceholder}}">
                        <button type="submit" aria-label="{{../sendLabel}}">
                            <i class="fas fa-paper-plane" aria-hidden="true"></i>
                        </button>
                    </form>
                    {{/if}}
                </div>
            </article>
            {{/each}}
        {{else if isBank}}
            {{#if balanceText}}
            <div class="lph-bank-balance">
                <span class="lph-bank-balance-label">{{balanceLabel}}</span>
                <span class="lph-bank-balance-value">{{balanceText}}</span>
            </div>
            {{/if}}
            {{#each items}}
            <article class="lph-card lph-bank-row" data-lph-expand role="button" tabindex="0" aria-expanded="false">
                <div class="lph-bank-row-head">
                    {{#if this.sender}}<span class="lph-card-sender">{{this.sender}}</span>{{/if}}
                    {{#if this.amountText}}<span class="lph-bank-amount {{#if this.credit}}is-credit{{else}}is-debit{{/if}}">{{this.amountText}}</span>{{/if}}
                </div>
                {{#if this.title}}<h4 class="lph-card-title">{{this.title}}</h4>{{/if}}
                {{#if this.body}}<div class="lph-bank-detail"><p class="lph-card-body">{{this.body}}</p></div>{{/if}}
            </article>
            {{/each}}
        {{else if isNews}}
            {{#each items}}
            <article class="lph-card lph-news-item" data-lph-expand role="button" tabindex="0" aria-expanded="false">
                <div class="lph-card-head">
                    {{#if this.sender}}<span class="lph-card-sender">{{this.sender}}</span>{{/if}}
                    {{#if this.unread}}<span class="lph-news-badge">{{../newBadge}}</span>{{/if}}
                </div>
                {{#if this.title}}<h4 class="lph-news-title">{{this.title}}</h4>{{/if}}
                {{#if this.body}}<p class="lph-news-excerpt">{{this.excerpt}}</p>{{/if}}
                {{#if this.body}}<div class="lph-news-body"><p class="lph-card-body">{{this.body}}</p></div>{{/if}}
            </article>
            {{/each}}
        {{else}}
            {{#each items}}
            <article class="lph-card">
                <div class="lph-card-head">
                    {{#if this.icon}}<i class="{{this.icon}}" aria-hidden="true"></i>{{/if}}
                    {{#if this.sender}}<span class="lph-card-sender">{{this.sender}}</span>{{/if}}
                </div>
                {{#if this.image}}<img class="lph-card-image" data-lph-media-view="{{this.image}}" src="{{this.image}}" alt="" loading="lazy">{{/if}}
                {{#if this.title}}<h4 class="lph-card-title">{{this.title}}</h4>{{/if}}
                {{#if this.body}}<p class="lph-card-body">{{this.body}}</p>{{/if}}
            </article>
            {{/each}}
        {{/if}}
    {{else}}
        <p class="lph-content-empty">{{emptyText}}</p>
    {{/if}}
    {{#if (eq appId "photos")}}
    <div class="lph-media-viewer" data-lph-media-viewer role="dialog" aria-modal="true" tabindex="-1" hidden>
        <header class="lph-media-viewer-head">
            <strong data-lph-media-title></strong>
            <button type="button" data-lph-media-close aria-label="{{localize 'LPH.Phone.Close'}}">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <img data-lph-media-image alt="">
    </div>
    {{/if}}
</div>
