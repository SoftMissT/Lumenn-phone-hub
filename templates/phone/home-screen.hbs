<div class="lph-home-screen">
    <div class="lph-home-widget" aria-hidden="true">
        <span class="lph-home-widget-time">{{time}}</span>
        <span class="lph-home-widget-date">{{date}}</span>
        <i class="fas fa-cloud-sun"></i>
    </div>

    <div class="lph-home-search" aria-hidden="true">
        <i class="fas fa-magnifying-glass"></i>
        <span></span>
        <i class="fas fa-microphone"></i>
    </div>

    <div class="lph-app-grid">
        {{#each apps}}
        <button type="button" class="lph-app-icon" data-app-id="{{this.id}}" data-lph-launch-app aria-label="{{this.title}}">
            <div class="lph-app-glyph{{#if this.tile}} lph-app-tile{{/if}}"{{#if this.tile}} style="background:{{this.tile}}"{{/if}}>
                <i class="{{this.icon}}" aria-hidden="true"></i>
            </div>
            <span class="lph-app-label">{{this.title}}</span>
        </button>
        {{/each}}
    </div>

    <div class="lph-dock-container">
        {{#each dockApps}}
        <button type="button" class="lph-app-icon" data-app-id="{{this.id}}" data-lph-launch-app aria-label="{{this.title}}">
            <div class="lph-app-glyph{{#if this.tile}} lph-app-tile{{/if}}"{{#if this.tile}} style="background:{{this.tile}}"{{/if}}>
                <i class="{{this.icon}}" aria-hidden="true"></i>
            </div>
        </button>
        {{/each}}
    </div>
</div>
