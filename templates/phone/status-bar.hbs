<div class="lph-status-bar">
    <div class="lph-status-left">
        <span class="lph-clock-time">{{time}}</span>
    </div>
    <div class="lph-status-right">
        <i class="fas fa-signal" title="{{localize 'LPH.Status.Signal'}}"></i>
        <i class="fas fa-wifi" title="{{localize 'LPH.Status.Wifi'}}"></i>
        <i class="fas fa-battery-three-quarters" title="{{localize 'LPH.Status.Battery'}}"></i>
    </div>
</div>
